{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "aylayoo-service",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 4003 },
  // Browsers may call the API from these origins and no others. Every front-end address needs
  // an entry here, and the list only takes effect once *this* service is redeployed — adding a
  // domain in Cloudflare is not enough, which is how aylayoo.com first went live with a working
  // page but an empty map.
  //
  //   aylayoo.com / www.aylayoo.com  the custom domain, apex and www. Both are listed because
  //                                  an Origin header is matched exactly: www is a different
  //                                  origin from the apex even when one redirects to the other.
  //   aylayoo-web…workers.dev        the original address, still live and still supported.
  //   ayalyoo-web.vercel.app         the old deployment, kept deliberately — note it reads
  //                                  "ayalyoo", which is how that project is actually named.
  //   localhost:3000 / :5173         the dev server (which is why that port is pinned).
  //   localhost:8787                 `opennextjs-cloudflare preview`, which serves the built
  //                                  Worker locally but builds against the live API.
  "vars": {
    "ALLOWED_ORIGINS": "https://aylayoo.com,https://www.aylayoo.com,https://aylayoo-web.sbolorsaikhan4.workers.dev,https://ayalyoo-web.vercel.app,http://localhost:3000,http://localhost:5173,http://localhost:8787"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aylayoo-db",
      "database_id": "2e8bcf0e-f423-4020-9e53-dbdc483d4e5c",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "aylayoo-images" }
  ],
  // Counters for the IP rate limiter on /register, /contact and /admin/login.
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "033f8078ce1c43eebbdc9cd9186442f1" }
  ],

  /* The retention passes on trip_requests, run daily by src/index.ts's `scheduled` handler.
   *
   * This exists because the privacy notice on the trip request form promises the traveller two
   * dates — contact details cleared 90 days after the trip or the closure, the whole request
   * gone at 24 months — and until this cron those were promises nothing kept. See
   * src/lib/retention.ts for the rule and README.md for the manual procedure that covers a
   * cron that has stopped running.
   *
   * 03:17 UTC: off the hour, because every cron on the platform fires on the hour and the
   * minute past is where the contention is. Daily rather than hourly — the boundaries are days
   * and months, so an hourly pass would do the same work 23 extra times.
   *
   * A Cron Trigger is only registered by a `wrangler deploy`. Adding it here changes nothing
   * until the service is deployed, and `wrangler deployments list` does not show it — check
   * the Worker's Settings → Trigger Events in the dashboard, or `wrangler triggers deploy`. */
  "triggers": {
    "crons": ["17 3 * * *"]
  },

  /* Workers Logs — retained and queryable in the dashboard, rather than `wrangler tail`'s
   * live-only view.
   *
   * Added because an incident could not be investigated without it: guides' phone numbers and
   * email addresses were served publicly for about a month, and there was no way to tell
   * whether anyone had fetched them, in either direction. See docs/incidents.md.
   *
   * Sampling is 1 (keep everything). This Worker serves a small site, so there is no volume
   * argument for dropping requests, and a sampled log is worth much less when the question is
   * "did this specific path get hit".
   *
   * WHAT THIS RETAINS IS NOW A PRIVACY DECISION, and src/lib/logging.ts is where it is made:
   * the request log carries the path with its query string stripped, errors are reduced to a
   * type and a redacted message, and the rate limiter never logs its KV key (which embeds the
   * client IP). No request bodies, no headers, no tokens. logging.spec.ts pins all of it.
   * Before adding a console.* call anywhere in this service, read that file. */
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      /* Cloudflare's own invocation logs are OFF, and only our console output is kept.
       *
       * The Workers Logs docs say an invocation log carries "details such as the Request,
       * Response, and related metadata", "enriched with information available to Cloudflare in
       * the context of the invocation". A Request includes its URL, and our URLs carry query
       * strings — so an invocation log would re-record exactly what lib/logging.ts strips out of
       * ours. The docs do not enumerate whether headers or the client IP are included either,
       * and an unenumerated "related metadata" is not something to opt into when the whole
       * point of this setup is knowing what the logs hold.
       *
       * https://developers.cloudflare.com/workers/observability/logs/workers-logs/
       *
       * The cost is real: without invocation logs there is no automatic per-request record, so
       * an incident is investigated through the hono request line in our own logs (path, status,
       * timing — no query) rather than Cloudflare's richer one. That is the trade we want: the
       * question "was this path hit" stays answerable, and the logs do not become a second copy
       * of the data. */
      "invocation_logs": false
    }
  }
}
