{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "aylayoo-service",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "dev": { "port": 4003 },
  // Browsers may call the API from these origins and no others. The front end now lives on
  // the workers.dev address; localhost:3000 is the dev server (which is why that port is
  // pinned), and the .vercel.app entry is the old deployment, kept deliberately — note it
  // reads "ayalyoo", which is how that project is actually named.
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:3000,http://localhost:5173,https://ayalyoo-web.vercel.app,https://aylayoo-web.sbolorsaikhan4.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aylayoo-db",
      "database_id": "2e8bcf0e-f423-4020-9e53-dbdc483d4e5c",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "aylayoo-images" }
  ],
  // Counters for the IP rate limiter on /register, /contact and /admin/login.
  "kv_namespaces": [
    { "binding": "RATE_LIMIT", "id": "033f8078ce1c43eebbdc9cd9186442f1" }
  ]
}
